APP_ENV=development
APP_URL=http://127.0.0.1:8080
APP_TIMEZONE=Europe/Istanbul
# Optional first-time browser setup at /install. Use a private random 32+ character
# The installer is tokenless and locks automatically after the first administrator.
# Absolute path optional; default storage/app.sqlite
DB_PATH=
# Product update identity. Keep the private signing key only on the release server;
# customer installations receive the matching public key.
PRODUCT_SLUG=transport-cms
APP_VERSION=1.0.0
RELEASE_SIGNING_PUBLIC_KEY=
# External integrations are disabled until explicitly configured.
AI_API_KEY=
# Optional OpenAI-compatible endpoint, e.g. https://openrouter.ai/api or
# http://127.0.0.1:11434/v1 for a local Ollama-compatible server.
AI_BASE_URL=
BING_SITE_VERIFICATION=
YANDEX_VERIFICATION=
FACEBOOK_DOMAIN_VERIFICATION=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Set to 1 only for local SMTP testing; never for remote servers.
SMTP_ALLOW_INSECURE_LOCAL=0
# SMS providers (choose one in Admin > Integrations; keep secrets out of Git)
NETGSM_USER=
NETGSM_PASSWORD=
NETGSM_HEADER=
ILETIMERKEZI_API_KEY=
ILETIMERKEZI_API_HASH=
ILETIMERKEZI_SENDER=APITEST
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
# Meta WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional inbound mailbox. IMAP is read-only; install PHP's imap extension.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_RETENTION_DAYS=0
