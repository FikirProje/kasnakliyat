APP_ENV=development
APP_URL=http://127.0.0.1:8080
APP_TIMEZONE=Europe/Istanbul
# Optional first-time browser setup at /install. Use a private random 32+ character
# token, then remove this variable after creating the first administrator.
INSTALL_TOKEN=
# Absolute path optional; default storage/app.sqlite
DB_PATH=
# External integrations are disabled until explicitly configured.
AI_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Set to 1 only for local SMTP testing; never for remote servers.
SMTP_ALLOW_INSECURE_LOCAL=0
# Optional inbound mailbox. IMAP is read-only; install PHP's imap extension.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
